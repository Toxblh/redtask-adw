  "mention_query": {
    "_": "Запрос @упоминания по тексту до курсора: «@» не после буквы, цифры, «_» или «@» (любой алфавит — e-mail и почта@кириллица не упоминания), дальше [буквы цифры _ . -]* до курсора. Нет — null. cursor — позиция в символах (UTF-16 = кодпоинты для этих строк).",
    "cases": [
      {
        "text": "привет @ив",
        "cursor": 10,
        "query": "ив"
      },
      {
        "text": "@",
        "cursor": 1,
        "query": ""
      },
      {
        "text": "mail a@b",
        "cursor": 8,
        "query": null
      },
      {
        "text": "почта@ив",
        "cursor": 8,
        "query": null
      },
      {
        "text": "@@x",
        "cursor": 3,
        "query": null
      },
      {
        "text": "@ivanov ",
        "cursor": 8,
        "query": null
      },
      {
        "text": "см. @ivan.petrov",
        "cursor": 16,
        "query": "ivan.petrov"
      },
