<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>ru.toxblh.RedTask</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>RedTask</name>
  <summary>Native client for Redmine</summary>
  <description>
    <p>RedTask is a client for Redmine. Work with Redmine issues from the desktop or a phone: lists, comments with Textile formatting,
    status changes, time tracking, attachments and background notifications.</p>
    <ul>
      <li>My issues, watched issues, favorites, projects and search</li>
      <li>Issue view with comments, changes and time log</li>
      <li>Status, assignee, progress, priority and all fields including custom ones</li>
      <li>Notifications about comments, mentions and changes</li>
      <li>Links to issues, projects and people of your server open in the app — with a link router such as Switchyard</li>
    </ul>
    <p>RedTask is an independent project and is not affiliated with or endorsed by the Redmine project.</p>
  </description>
  <developer id="ru.toxblh">
    <name>Anton Palgunov</name>
  </developer>
  <launchable type="desktop-id">ru.toxblh.RedTask.desktop</launchable>
  <url type="homepage">https://github.com/Toxblh/redtask-adw</url>
  <url type="bugtracker">https://github.com/Toxblh/redtask-adw/issues</url>
  <url type="vcs-browser">https://github.com/Toxblh/redtask-adw</url>
  <screenshots>
    <screenshot type="default">
      <caption>Issue list and issue view</caption>
      <image>https://raw.githubusercontent.com/Toxblh/redtask-adw/v1.1.1/docs/screenshots/wide-light.png</image>
    </screenshot>
    <screenshot>
      <caption>Mobile layout</caption>
      <image>https://raw.githubusercontent.com/Toxblh/redtask-adw/v1.1.1/docs/screenshots/narrow-light.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <branding>
    <color type="primary" scheme_preference="light">#f66151</color>
    <color type="primary" scheme_preference="dark">#a51d2d</color>
  </branding>
  <releases>
    <release version="1.1.2" date="2026-11-12">
      <description>
        <p>Custom filters and saved queries — on the device and on the server; favourite queries in the sidebar show how many unread issues they hold.</p>
        <p>Unread issues and notifications are marked with a dot, with “Mark all as read”. Add watchers right from the issue.</p>
        <p>More reliable notifications: checks every 5 minutes, keeps running in the background, and checks right after waking from sleep.</p>
      </description>
    </release>
    <release version="1.1.1" date="2026-11-08"/>
    <release version="1.1.0" date="2026-11-07"/>
    <release version="1.0.1" date="2026-10-23"/>
    <release version="0.1.0" date="2026-10-22"/>
  </releases>
</component>
