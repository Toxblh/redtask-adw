<?xml version="1.0" encoding="UTF-8"?>
<!--
  Окно: разделы (сайдбар) → список → задача.
  Широко: три колонки. Средне (≤ 860sp): сайдбар разделов выезжает поверх по кнопке.
  Узко (≤ 500sp): список и задача — навигационный стек, разделы — AdwViewSwitcherBar снизу.
-->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.9"/>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_New Issue</attribute>
        <attribute name="action">win.new-issue</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Refresh</attribute>
        <attribute name="action">win.refresh</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Preferences</attribute>
        <attribute name="action">app.preferences</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">app.shortcuts</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About Redmine</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
  <template class="RedmineWindow" parent="AdwApplicationWindow">
    <property name="width-request">360</property>
    <property name="height-request">294</property>
    <property name="title" translatable="yes">Redmine</property>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 860sp</condition>
        <setter object="outer" property="collapsed">True</setter>
        <setter object="sidebar_button" property="visible">True</setter>
      </object>
    </child>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 500sp</condition>
        <setter object="outer" property="collapsed">True</setter>
        <setter object="outer" property="enable-show-gesture">False</setter>
        <setter object="inner" property="collapsed">True</setter>
        <setter object="switcher_bar" property="reveal">True</setter>
      </object>
    </child>
    <property name="content">
      <object class="AdwToastOverlay" id="toasts">
        <property name="child">
          <object class="GtkStack" id="root_stack">
            <property name="transition-type">crossfade</property>
            <child>
              <object class="GtkStackPage">
                <property name="name">loading</property>
                <property name="child">
                  <object class="AdwToolbarView">
                    <child type="top">
                      <object class="AdwHeaderBar">
                        <property name="show-title">False</property>
                      </object>
                    </child>
                    <property name="content">
                      <object class="AdwSpinner">
                        <property name="halign">center</property>
                        <property name="valign">center</property>
                        <property name="width-request">32</property>
                        <property name="height-request">32</property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">main</property>
                <property name="child">
                  <object class="AdwOverlaySplitView" id="outer">
                    <property name="min-sidebar-width">200</property>
                    <property name="max-sidebar-width">260</property>
                    <property name="sidebar">
                      <object class="AdwToolbarView">
                        <child type="top">
                          <object class="AdwHeaderBar">
                            <property name="title-widget">
                              <object class="AdwWindowTitle">
                                <property name="title" translatable="yes">Redmine</property>
                              </object>
                            </property>
                            <child type="start">
                              <object class="GtkButton">
                                <property name="icon-name">list-add-symbolic</property>
                                <property name="tooltip-text" translatable="yes">New Issue</property>
                                <property name="action-name">win.new-issue</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <property name="content">
                          <object class="AdwViewSwitcherSidebar" id="switcher_sidebar">
                            <property name="stack">sections</property>
                            <signal name="activated" handler="on_section_activated"/>
                          </object>
                        </property>
                      </object>
                    </property>
                    <property name="content">
                      <object class="AdwNavigationSplitView" id="inner">
                        <property name="min-sidebar-width">300</property>
                        <property name="max-sidebar-width">420</property>
                        <property name="sidebar-width-fraction">0.38</property>
                        <property name="sidebar">
                          <object class="AdwNavigationPage" id="list_page">
                            <property name="title" translatable="yes">Issues</property>
                            <property name="child">
                              <object class="AdwNavigationView" id="list_nav">
                                <child>
                                  <object class="AdwNavigationPage" id="sections_page">
                                    <property name="tag">sections</property>
                                    <property name="title" translatable="yes">Issues</property>
                                    <property name="child">
                                      <object class="AdwToolbarView">
                                        <child type="top">
                                          <object class="AdwHeaderBar">
                                            <child type="start">
                                              <object class="GtkToggleButton" id="sidebar_button">
                                                <property name="visible">False</property>
                                                <property name="icon-name">sidebar-show-symbolic</property>
                                                <property name="tooltip-text" translatable="yes">Show Sections</property>
                                                <property name="active" bind-source="outer" bind-property="show-sidebar" bind-flags="bidirectional|sync-create"/>
                                              </object>
                                            </child>
                                            <property name="title-widget">
                                              <object class="AdwWindowTitle" id="section_title">
                                                <property name="title" translatable="yes">Issues</property>
                                              </object>
                                            </property>
                                            <child type="end">
                                              <object class="GtkMenuButton">
                                                <property name="icon-name">open-menu-symbolic</property>
                                                <property name="menu-model">primary_menu</property>
                                                <property name="primary">True</property>
                                                <property name="tooltip-text" translatable="yes">Main Menu</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <property name="content">
                                          <object class="AdwViewStack" id="sections">
                                            <property name="vhomogeneous">False</property>
                                          </object>
                                        </property>
                                        <child type="bottom">
                                          <object class="AdwViewSwitcherBar" id="switcher_bar">
                                            <property name="stack">sections</property>
                                          </object>
                                        </child>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                        <property name="content">
                          <object class="AdwNavigationPage" id="content_page">
                            <property name="title" translatable="yes">Issue</property>
                            <property name="child">
                              <object class="AdwNavigationView" id="issue_nav">
                                <child>
                                  <object class="AdwNavigationPage">
                                    <property name="tag">empty</property>
                                    <property name="title" translatable="yes">Issue</property>
                                    <property name="child">
                                      <object class="AdwToolbarView">
                                        <child type="top">
                                          <object class="AdwHeaderBar">
                                            <property name="show-title">False</property>
                                          </object>
                                        </child>
                                        <property name="content">
                                          <object class="AdwStatusPage">
                                            <property name="icon-name">ru.toxblh.RedmineAdw-symbolic</property>
                                            <property name="title" translatable="yes">No Issue Selected</property>
                                            <property name="description" translatable="yes">Choose an issue from the list</property>
                                          </object>
                                        </property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
