{
  "id": "ru.toxblh.RedTask",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "redtask",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--talk-name=org.gnome.NautilusPreviewer"
  ],
  "cleanup": ["/include", "/lib/pkgconfig", "/share/vala", "*.la", "*.a"],
  "modules": [
    {
      "name": "redtask",
      "buildsystem": "meson",
      "sources": [
        { "type": "dir", "path": "." }
      ]
    }
  ]
}
